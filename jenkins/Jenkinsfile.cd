pipeline {
  agent { label 'kubernetes-deployer' }

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  parameters {
    choice(name: 'ENVIRONMENT', choices: ['dev', 'sit1', 'sit4', 'perf', 'prod'], description: 'Deployment environment')
    string(name: 'APP_VERSION', defaultValue: '1.0.0', description: 'Image tag produced by CI')
    string(name: 'ACM_CERTIFICATE_ARN', defaultValue: '', description: 'ACM certificate ARN from Terraform')
    string(name: 'PLATFORM_BRANCH', defaultValue: 'main')
    string(name: 'IAC_BRANCH',defaultValue: 'main')
  }

  environment {
    APP_NAME = 'auspost-health'
    JFROG_REGISTRY = 'jfrog.auspost.com'
    JFROG_PROJECT = 'AusPostJrog'
    CLUSTER_NAME = 'auspost-eks'
    AWS_REGION = 'ap-southeast-2'
    VAULT_ADDR = credentials('vault-addr')
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Pull/Verify Image') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'jfrog-credentials',
          usernameVariable: 'JFROG_USER',
          passwordVariable: 'JFROG_PASSWORD'
        )]) {
          sh '''
            set -e
            echo "$JFROG_PASSWORD" | docker login "$JFROG_REGISTRY" -u "$JFROG_USER" --password-stdin
            docker pull "$JFROG_REGISTRY/$JFROG_PROJECT/$APP_NAME:$APP_VERSION"
          '''
        }
      }
    }

    stage('Checkout Kubernetes Platform') {
      steps {
          dir('platform') {
              git branch: params.IAC_BRANCH,
                  url: 'https://github.com/ravishaggarwal/AusPost-platformKubernetes.git'
          }
        }
    }

    stage('Checkout AWS IaC') {
        steps {
            dir('aws-iac') { 
                git branch: params.IAC_BRANCH,
                    url: 'https://github.com/ravishaggarwal/AusPost-aws-iac.git'
            }
        }
      }

    stage('Deploy') {
      steps {
        withCredentials([
          [$class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'aws-deploy-role',
            accessKeyVariable: 'AWS_ACCESS_KEY_ID',
            secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'],
          usernamePassword(
            credentialsId: 'jfrog-credentials',
            usernameVariable: 'JFROG_USER',
            passwordVariable: 'JFROG_PASSWORD')
        ]) {
           dir('platform') {
              sh '''
                set -e
                test -n "$ACM_CERTIFICATE_ARN"

                aws eks update-kubeconfig --region "$AWS_REGION" --name "$CLUSTER_NAME"

                kubectl create namespace "auspost-$ENVIRONMENT"               --dry-run=client -o yaml | kubectl apply -f -

                kubectl create secret docker-registry jfrog-registry               --namespace "auspost-$ENVIRONMENT"               --docker-server="$JFROG_REGISTRY"               --docker-username="$JFROG_USER"               --docker-password="$JFROG_PASSWORD"               --dry-run=client -o yaml | kubectl apply -f -
                
                chmod +x scripts/deploy.sh

                    ./scripts/deploy.sh "$ENVIRONMENT" "$APP_VERSION"
                '''
           }
        }
      }
    }
    stage('Wait for ALB') {
      steps {
          sh '''
              set -e
              NAMESPACE="auspost-$ENVIRONMENT"
              echo "Waiting for ALB hostname..."
              for attempt in $(seq 1 60)
              do
                  ALB_HOSTNAME="$(
                      kubectl get ingress "$APP_NAME" \
                          --namespace "$NAMESPACE" \
                          -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' \
                          2>/dev/null || true
                  )"
                  if [ -n "$ALB_HOSTNAME" ]; then
                      echo "ALB is ready:"
                      echo "$ALB_HOSTNAME"
                      exit 0
                  fi
                  echo "Attempt ${attempt}/60 - ALB not ready."
                  sleep 10
              done
              echo "ERROR: ALB was not provisioned within 10 minutes."
              kubectl describe ingress "$APP_NAME" \
                  --namespace "$NAMESPACE" || true
              exit 1
          '''
      }
  }
    stage('Configure Route53') {
    steps {
        withCredentials([
            [$class: 'AmazonWebServicesCredentialsBinding',
             credentialsId: 'aws-deploy-role',
             accessKeyVariable: 'AWS_ACCESS_KEY_ID',
             secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
        ]) {
            sh '''
                set -e
                export NAMESPACE="auspost-$ENVIRONMENT"
                export INGRESS_NAME="$APP_NAME"
                export DOMAIN_NAME="myauspost.com.au"
                export HOSTED_ZONE_ID="$(
                    terraform \
                        -chdir=aws-iac/terraform \
                        output \
                        -raw route53_zone_id
                )"
                chmod +x aws-iac/scripts/set-route53-alb.sh
                ./aws-iac/scripts/set-route53-alb.sh
            '''
        }
    }
  }

    stage('Validate') {
      steps {
        sh '''
          set -e
          kubectl rollout status deployment/"$APP_NAME"             -n "auspost-$ENVIRONMENT" --timeout=10m
          kubectl get pods             -n "auspost-$ENVIRONMENT"             -l "app.kubernetes.io/name=$APP_NAME"
          kubectl run health-check-"$BUILD_NUMBER"             -n "auspost-$ENVIRONMENT"             --rm -i --restart=Never             --image=curlimages/curl:8.16.0             --command --             curl -fsS "http://$APP_NAME/health"
        '''
      }
    }
  }

  post {
    failure {
      sh '''
        kubectl rollout undo deployment/"$APP_NAME"           -n "auspost-$ENVIRONMENT" || true
      '''
    }
  }
}
